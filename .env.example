# AniWave — BotHost configuration
BOT_TOKEN=
BOT_USERNAME=

# Владелец бота: один Telegram user ID.
ADMIN_ID=

# Единственный разрешённый канал для публикаций, например -1001234567890.
# Из любого другого канала AniWave автоматически выйдет.
CHANNEL_ID=

# Ссылка для inline-кнопки «Найти аниме» под каждым релизом.
ANIME_SEARCH_URL=

# SQLite работает без внешней БД.
DATABASE_URL=

# Проверка источников раз в N секунд.
MONITOR_INTERVAL_SECONDS=
ANICLI_PROVIDERS=
RSS_CONFIG_PATH=

# trace.moe supporter key необязателен.
TRACE_MOE_KEY=
TRACE_MIN_SIMILARITY=

HTTP_TIMEOUT_SECONDS=
USER_AGENT=

HEALTH_ENABLED=
HEALTH_HOST=
HEALTH_PORT=
LOG_LEVEL=
